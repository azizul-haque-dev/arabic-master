NODE_ENV=development
PORT=5000
API_PREFIX=api
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/arabic_app
REDIS_URL=redis://localhost:6379

# প্রতিটি secret কমপক্ষে ৩২ অক্ষর এবং আলাদা আলাদা (openssl rand -hex 32)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
TOKEN_HASH_SECRET=
PASSWORD_RESET_EXPIRES_IN=15m

AUTH_COOKIE_NAME=refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_HTTP_ONLY=true
AUTH_COOKIE_SAME_SITE=lax

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

GOOGLE_API_KEY=
AI_MODEL_NAME=

# Cloudflare R2 Object Storage (S3-compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=arabic-master-audio
# R2_ENDPOINT is optional if R2_ACCOUNT_ID is set (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_REGION=auto
# Optional: Public CDN/domain if media is intentionally served publicly (e.g. https://media.yourdomain.com)
# When omitted, secure short-lived presigned GET URLs are generated for playback.
R2_PUBLIC_BASE_URL=
R2_KEY_PREFIX=arabic-entities/audio/
R2_MAX_AUDIO_SIZE_BYTES=10485760
R2_PRESIGNED_EXPIRES_IN=3600
